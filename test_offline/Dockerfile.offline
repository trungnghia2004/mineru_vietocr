FROM python:3.12-slim

# Prevent Python from writing .pyc files and ensure unbuffered output
# Set MinerU to use local models instead of downloading
# Force CPU-only mode to avoid CUDA dependencies
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MINERU_MODEL_SOURCE=local \
    MINERU_TOOLS_CONFIG_JSON=/app/mineru.json \
    MINERU_DEVICE_MODE=cpu

WORKDIR /app

# System dependencies commonly required by OpenCV, Torch, and image handling
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgl1 \
&& rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt /app/requirements.txt
# Install CPU-only PyTorch first to avoid downloading CUDA versions
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir -r requirements.txt

# Copy the pre-downloaded models into the container
# This is the key step - models are baked into the image
COPY test_offline/models_cache/pipeline /app/models/pipeline

# Copy the configuration file that points to local models
COPY test_offline/mineru.json /app/mineru.json

# Copy VietOCR config and pre-downloaded models
COPY vietocr/config /app/vietocr/config
COPY vietocr/downloaded_models /app/vietocr/downloaded_models

# Copy PyTorch VGG19 backbone model for VietOCR
RUN mkdir -p /root/.cache/torch/hub/checkpoints
COPY torch_models/checkpoints/vgg19_bn-c79401a0.pth /root/.cache/torch/hub/checkpoints/vgg19_bn-c79401a0.pth

# Copy application source code (only necessary files, not entire workspace)
COPY mineru /app/mineru
COPY vietocr/vietocr /app/vietocr/vietocr
COPY app.py /app/
COPY templates /app/templates

# Ensure output directory exists (can be mounted as volume at runtime)
RUN mkdir -p output

EXPOSE 8088

# Minimal workers as default; can be overridden at runtime
ENV UVICORN_WORKERS=1

# Start FastAPI with Uvicorn
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8088"]

